  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - 'Announcer: That is correct!

'
  - 'Announcer: Congratulations, Arundina! You are this year''s 3rd grade spelling
    bee champion!

'
  - 'Parents: Go, Arundina!'
  - 'Parents: We''re so proud of you!'
  - 'Arundina: <i>I was proud of myself in this moment too!</i>

'
  - 'Arundina: <i>I remember studying so hard and it really paid off.</i>'
