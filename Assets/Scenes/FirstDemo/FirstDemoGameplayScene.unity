--- !u!114 &1321600785
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1321600779}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8a93004069ba72343a1896c426e2ec6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - 'Arundina: Why wouldn''t I?'
  - 'Charlotte: No one likes a loser.'
  - 'Arundina: Are you really a loser if you made it all the way to the finals?'
  - 'Charlotte: Yes!

'
  - 'Charlotte: You don''t get it! First place gets everything. Second place is as
    good as last.'
  - 'Charlotte: I needed that money.'
  - 'Arundina: ...

'
  - 'Charlotte: My parents were already so angry with me. This was my last chance
    to prove to them...'
  - "Arundina: Prove to them\u2026?"
  - 'Charlotte: Nevermind.'
--- !u!114 &1321600786
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1321600779}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad608e44f72f7844083f818d0e2cdc06, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sprite: {fileID: 21300000, guid: 7c6ee2503916bd844b50aa4c98f49558, type: 3}
--- !u!114 &1321600787
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1321600779}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8a93004069ba72343a1896c426e2ec6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - 'Charlotte: ...'
  - 'Charlotte: What are you looking at?'
  - 'Arundina: Sorry, I didn''t mean to stare.'
  - 'Arundina: ... '
  - 'Arundina: You okay?'
  - 'Charlotte: I''m fine.'
  - 'Charlotte: It''s not like <i>you</i> care.

'
  - 'Arundina: What?!'
  - 'Arundina: I do care!'
--- !u!114 &1321600788
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
