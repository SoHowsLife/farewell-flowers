  sprite: {fileID: 21300000, guid: 42950f63678442f439fa7d3a78278939, type: 3}
--- !u!114 &1321600789
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1321600779}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad608e44f72f7844083f818d0e2cdc06, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sprite: {fileID: 21300000, guid: 7e5ebdbdb4966ec439df85fe4d578c7b, type: 3}
--- !u!114 &1321600790
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1321600779}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8a93004069ba72343a1896c426e2ec6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - "Charlotte: What? N-no I can't do that. It's yours\u2014and plus, my parents
    would be super upset and\u2014"
  - 'Arundina: Just tell them that we had a rematch on our own.'
  - 'Arundina: And that you won. By a lot.'
  - 'Charlotte: ...'
  - 'Charlotte: Here.'
  - 'Arundina: ?'
--- !u!114 &1321600791
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1321600779}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad608e44f72f7844083f818d0e2cdc06, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sprite: {fileID: 21300000, guid: 7c6ee2503916bd844b50aa4c98f49558, type: 3}
--- !u!114 &1321600792
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1321600779}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8a93004069ba72343a1896c426e2ec6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - 'Charlotte: My parents would''ve given me an earful if I had said something like
    that.'
  - 'Arundina: Yeah, well if they do then they''re going to get an earful from <i>me</i>!

'
  - "Charlotte: Hehe\u2026\n"
  - 'Charlotte: Thanks...

'
  - 'Arundina: ?'
  - 'Arundina: What for?'
  - 'Charlotte: For being such a great competitor.

'
  - "Charlotte: It's hard to be a loser, but\u2026"
  - 'Charlotte: You made it just a little bit easier.'
  - 'Arundina: Stop calling yourself that.'
  - 'Arundina: Plus, I think I got the easier words.'
  - 'Charlotte: You totally did.'
  - 'Arundina: Honestly, I just wanted to win so that I could buy myself a pottery
    wheel set.'
  - 'Arundina: You can have the rest of the prize money.'
--- !u!114 &1321600793
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1321600779}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad608e44f72f7844083f818d0e2cdc06, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sprite: {fileID: 21300000, guid: 2c565d81446f3ad4e9cf7ec0d2df21f4, type: 3}
--- !u!114 &1321600794
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1321600779}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8a93004069ba72343a1896c426e2ec6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - 'Arundina: No!'
  - 'Charlotte: !!'
  - 'Arundina: You don''t have to prove anything!'
  - 'Arundina: You''re smart. Really smart if you were able to make it this far.'
  - "Arundina: If your parents can't see that, then\u2014then\u2026"
  - 'Arundina: Then I''ll have a very serious talk with them!'
  - 'Charlotte: ...'
  - 'Charlotte: Hahahahaha!'
  - 'Arundina: ?'
  - 'Arundina: What''s so funny?

'
  - 'Charlotte: I''ve never heard a kid talk about an adult like that!'
--- !u!114 &1321600795
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1321600779}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8a93004069ba72343a1896c426e2ec6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - "Charlotte: My parents thought I would win so they got me this. It's a little
    scuffed up\u2026"
  - "Charlotte: And it's definitely not enough to make up for the prize money\u2026"
  - 'Charlotte: But I want you to have it!'
