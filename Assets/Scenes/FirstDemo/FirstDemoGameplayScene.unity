  m_Script: {fileID: 11500000, guid: 8a93004069ba72343a1896c426e2ec6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - 'Announcer: Welcome to the annual 3rd grade spelling bee finals!'
  - 'Announcer: Today, we have Charlotte and Arundina competing for the title of
    spelling bee champion.'
  - 'Announcer: Our winner will walk away with a cash prize of $1,000. Both of them
    have worked very hard to get here, so let''s give them a round of applause!'
  - 'Announcer: Contestants, please step up to the microphone when you''re ready.'
